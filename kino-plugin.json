{
  "id": "megaplay",
  "name": "Megaplay",
  "version": "1.2.0",
  "apiVersion": 9,
  "streamHosts": "any",
  "entry": "plugin.js",
  "icon": "icon.png",
  "description": "Anime japonés subtitulado al español y otros idiomas, o doblado: series y películas con pantalla propia, el catálogo de TMDB y los episodios de Megaplay",
  "author": "xuper-plugin",
  "homepage": "https://github.com/xuper-plugin/kino-plugin-megaplay",
  "color": "#7C3AED",
  "categories": [
    "anime"
  ],
  "theme": {
    "accent": "#7C3AED",
    "onAccent": "#FFFFFF",
    "background": "#0E0A18",
    "surface": "#1B1430",
    "highlight": "#F0ABFC"
  },
  "section": {
    "label": "Megaplay",
    "labelEn": "Megaplay"
  },
  "hosts": [
    "image.tmdb.org",
    "megaplay.buzz",
    "enc-dec.app",
    "graphql.anilist.co"
  ],
  "capabilities": [
    "search",
    "home",
    "browse",
    "episodes",
    "resolve"
  ],
  "settings": [
    {
      "key": "audioSection",
      "type": "section",
      "label": "Audio",
      "labelEn": "Audio",
      "hint": "Qué versión se abre primero; la otra queda como segunda opción en el reproductor.",
      "hintEn": "Which version opens first; the other stays as a second option in the player."
    },
    {
      "key": "audio",
      "type": "select",
      "label": "Versión preferida",
      "labelEn": "Preferred version",
      "default": "sub",
      "options": [
        {
          "value": "sub",
          "label": "Subtitulado (japonés)",
          "labelEn": "Subtitled (Japanese)"
        },
        {
          "value": "dub",
          "label": "Doblado",
          "labelEn": "Dubbed"
        }
      ]
    },
    {
      "key": "homeSection",
      "type": "section",
      "label": "Inicio de Kino",
      "labelEn": "Kino's Home"
    },
    {
      "key": "homeRows",
      "type": "toggle",
      "label": "Filas en Inicio",
      "labelEn": "Rows on Home",
      "default": true,
      "hint": "Muestra anime popular y en emisión en el Inicio de Kino.",
      "hintEn": "Shows popular and airing anime on Kino's Home."
    },
    {
      "key": "toolsSection",
      "type": "section",
      "label": "Herramientas",
      "labelEn": "Tools"
    },
    {
      "key": "clearCache",
      "type": "action",
      "label": "Borrar caché",
      "labelEn": "Clear cache"
    }
  ],
  "enhancements": {
    "14": {
      "capabilities": [
        "screen"
      ],
      "screen": {
        "label": "Megaplay",
        "labelEn": "Megaplay",
        "icon": "movie",
        "menuOpens": "screen",
        "opensFrom": [
          "menu",
          "settings"
        ],
        "settingsButton": {
          "label": "Abrir Megaplay",
          "labelEn": "Open Megaplay"
        },
        "settingsIn": "both"
      }
    },
    "19": {
      "capabilities": [
        "screen"
      ]
    },
    "20": {
      "provides": {
        "catalog": {
          "summary": "Titles this plugin finds, for the author's other plugins",
          "calls": {
            "search": {
              "in": {
                "q": "string",
                "type": "string?"
              },
              "out": "Item[]"
            }
          },
          "types": {
            "Item": {
              "id": "string",
              "ref": "string",
              "title": "string",
              "kind": "string",
              "poster": "string?",
              "backdrop": "string?",
              "year": "string?",
              "overview": "string?",
              "tmdb": "number?"
            }
          }
        }
      }
    }
  },
  "signature": {
    "authorKey": "6693946bd5c56196960959c4b9665fad5094374bcb85ddb282f8bf762c835263",
    "value": "f1f209ceb7eb97edbe2c75c24a374aff927e155e02d8d9f8f9571fefb96464d06bf2c1778024e6559bd84e6e5531c69b81fdab05e167cceecc7504a712308d0d"
  }
}
